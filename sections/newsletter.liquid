{% comment %}
  Newsletter Section
{% endcomment %}

<section class="py-16 bg-primary text-primary-text">
  <div class="aether-container max-w-2xl mx-auto text-center">
    <h2 class="text-3xl font-extrabold text-white mb-3">{{ 'newsletter.heading' | t }}</h2>
    <p class="text-white/80 text-sm mb-8 leading-relaxed">{{ 'newsletter.subtext' | t }}</p>

    {% form 'customer', class: 'flex flex-col sm:flex-row gap-3 max-w-md mx-auto' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        type="email"
        name="contact[email]"
        placeholder="{{ 'newsletter.email_placeholder' | t }}"
        required
        class="flex-grow bg-white/10 text-white placeholder-white/60 border border-white/20 rounded-md px-4 py-3 text-sm focus:outline-none focus:border-white"
      >
      <button type="submit" class="btn btn-secondary text-primary font-bold text-sm px-6 py-3 hover-lift">
        {{ 'newsletter.button' | t }}
      </button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "aether-newsletter",
  "settings": [],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
