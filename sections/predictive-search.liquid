{% comment %}
  Predictive Search Section / Template Response
{% endcomment %}

{% if search.performed %}
  {% if search.results_count > 0 %}
    <div class="p-3 bg-surface border-b border-border text-xs font-semibold text-text-muted">
      Products ({{ search.results_count }})
    </div>
    <ul class="divide-y divide-border list-none p-0 m-0">
      {% for item in search.results limit: 5 %}
        {% if item.object_type == 'product' %}
          <li>
            <a href="{{ item.url }}" class="flex items-center gap-3 p-3 hover:bg-surface transition-colors">
              {% if item.featured_media %}
                <img src="{{ item.featured_media | image_url: width: 80 }}" alt="{{ item.title }}" class="w-10 h-10 object-cover rounded">
              {% endif %}
              <div class="flex-grow">
                <h5 class="text-xs font-semibold text-primary m-0 line-clamp-1">{{ item.title }}</h5>
                <span class="text-xs text-text-muted font-medium">{{ item.price | money }}</span>
              </div>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% else %}
    <div class="p-4 text-xs text-text-muted text-center">
      No products found matching "{{ search.terms }}"
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Predictive Search",
  "settings": []
}
{% endschema %}
