{%- comment -%}
  Renders Organization JSON-LD structured data block.
{%- endcomment -%}

{%- assign org_name = settings.business_name | default: shop.name -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ org_name | json }},
  "url": {{ shop.url | append: page.url | json }}
  {%- if settings.logo != blank -%},
  "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }}
  {%- endif -%}
  {%- assign social_urls = '' -%}
  {%- if settings.social_instagram != blank -%}{%- assign social_urls = social_urls | append: ',' | append: settings.social_instagram -%}{%- endif -%}
  {%- if settings.social_facebook != blank -%}{%- assign social_urls = social_urls | append: ',' | append: settings.social_facebook -%}{%- endif -%}
  {%- if settings.social_tiktok != blank -%}{%- assign social_urls = social_urls | append: ',' | append: settings.social_tiktok -%}{%- endif -%}
  {%- if settings.social_pinterest != blank -%}{%- assign social_urls = social_urls | append: ',' | append: settings.social_pinterest -%}{%- endif -%}
  {%- if settings.social_youtube != blank -%}{%- assign social_urls = social_urls | append: ',' | append: settings.social_youtube -%}{%- endif -%}
  {%- if settings.social_x != blank -%}{%- assign social_urls = social_urls | append: ',' | append: settings.social_x -%}{%- endif -%}
  {%- assign social_array = social_urls | remove_first: ',' | split: ',' -%}
  {%- if social_array.size > 0 -%},
  "sameAs": [
    {%- for social_link in social_array -%}
      {{ social_link | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- endif -%}
}
</script>
