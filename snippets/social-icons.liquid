{%- comment -%}
  Renders list of social media icon links based on theme settings.
{%- endcomment -%}

{%- assign has_social = false -%}
{%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_pinterest != blank or settings.social_youtube != blank or settings.social_x != blank -%}
  {%- assign has_social = true -%}
{%- endif -%}

{%- if has_social -%}
  <ul class="social-icons" role="list">
    {%- if settings.social_instagram != blank -%}
      <li class="social-icons__item">
        <a href="{{ settings.social_instagram }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.instagram' | t }}">
          {% render 'icon', name: 'instagram', size: 18 %}
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_facebook != blank -%}
      <li class="social-icons__item">
        <a href="{{ settings.social_facebook }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.facebook' | t }}">
          {% render 'icon', name: 'facebook', size: 18 %}
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_tiktok != blank -%}
      <li class="social-icons__item">
        <a href="{{ settings.social_tiktok }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.tiktok' | t }}">
          {% render 'icon', name: 'tiktok', size: 18 %}
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_pinterest != blank -%}
      <li class="social-icons__item">
        <a href="{{ settings.social_pinterest }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.pinterest' | t }}">
          {% render 'icon', name: 'pinterest', size: 18 %}
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_youtube != blank -%}
      <li class="social-icons__item">
        <a href="{{ settings.social_youtube }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.youtube' | t }}">
          {% render 'icon', name: 'youtube', size: 18 %}
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_x != blank -%}
      <li class="social-icons__item">
        <a href="{{ settings.social_x }}" class="social-icons__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.x' | t }}">
          {% render 'icon', name: 'x-twitter', size: 18 %}
        </a>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
