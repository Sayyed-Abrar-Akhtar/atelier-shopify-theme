{% comment %}
  Sticky Add To Cart Bar Component (For Product Pages)
{% endcomment %}

{% if settings.enable_sticky_atc and product %}
  <div class="fixed bottom-0 left-0 right-0 bg-background border-t border-border shadow-2xl p-4 z-sticky-atc transition-transform duration-300 transform translate-y-full" data-sticky-atc>
    <div class="aether-container flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        {% if product.featured_media %}
          <img src="{{ product.featured_media | image_url: width: 100 }}" alt="{{ product.title }}" class="w-12 h-12 object-cover rounded">
        {% endif %}
        <div class="hidden sm:block">
          <h4 class="font-bold text-sm m-0 line-clamp-1">{{ product.title }}</h4>
          <span class="text-xs text-text-muted font-medium">{{ product.price | money }}</span>
        </div>
      </div>

      {% form 'product', product, class: 'flex items-center gap-3' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="btn btn-primary text-sm py-2.5 px-6" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}
            {{ 'products.add_to_cart' | t }}
          {% else %}
            {{ 'products.sold_out' | t }}
          {% endif %}
        </button>
      {% endform %}
    </div>
  </div>

  <style>
    [data-sticky-atc].is-visible {
      transform: translateY(0);
    }
  </style>
{% endif %}
