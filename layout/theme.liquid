<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if settings.enable_rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.search' | t }}: "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Open Graph & Social Meta Tags -->
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="website">
    {%- if page_description -%}
      <meta property="og:description" content="{{ page_description | escape }}">
    {%- endif -%}

    <!-- Hreflang support for EU, Cyprus, and International Markets -->
    {%- for locale in shop.published_locales -%}
      <link rel="alternate" hreflang="{{ locale.iso_code }}" href="{{ canonical_url }}?language={{ locale.iso_code }}">
    {%- endfor -%}

    <!-- Stylesheets -->
    {{ 'custom-properties.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <!-- Dynamic Theme Custom Properties Override -->
    <style>
      :root {
        --color-primary: {{ settings.color_primary | default: '#111827' }};
        --color-accent: {{ settings.color_accent | default: '#2563eb' }};
        --color-background: {{ settings.color_background | default: '#ffffff' }};
        --color-surface: {{ settings.color_surface | default: '#f9fafb' }};
        --color-text: {{ settings.color_text | default: '#111827' }};
        --color-sale: {{ settings.color_sale | default: '#dc2626' }};
        --font-body-size: {{ settings.font_body_size | default: 16 }}px;
        --container-width: {{ settings.container_max_width | default: 1320 }}px;
        --border-radius-md: {{ settings.border_radius_style | default: '8px' }};
      }
    </style>

    {{ content_for_header }}

    <!-- Dynamic JSON-LD Structured Data -->
    {% render 'json-ld' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="{% if settings.enable_animations %}animations-enabled{% else %}animations-disabled{% endif %} template-{{ template.name | handle }}">
    <a class="sr-only" href="#MainContent">{{ 'general.continue_shopping' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <!-- Global Cart Drawer & Quick View Overlay -->
    <div class="aether-overlay" data-aether-overlay></div>

    {% render 'ajax-cart' %}
    {% render 'quick-view' %}
    {% render 'cookie-consent' %}
  </body>
</html>
