<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>

    {% style %}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}

      :root {
        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }}, 'Segoe UI', Arial, sans-serif;
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }}, 'Segoe UI', Arial, sans-serif;
        --color-background: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-text: {{ settings.color_text }};
        --color-border: {{ settings.color_border }};
        --color-primary: {{ settings.color_primary }};
        --color-primary-text: {{ settings.color_primary_text }};
        --radius: {{ settings.border_radius }}px;
      }

      body {
        font-family: var(--font-body);
        background-color: var(--color-background);
        color: var(--color-text);
        margin: 0;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        box-sizing: border-box;
      }

      .password-container {
        max-width: 450px;
        width: 100%;
        text-align: center;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 2.5rem 2rem;
      }

      .password-logo {
        margin-bottom: 1.5rem;
        font-family: var(--font-heading);
        font-size: 1.75rem;
        font-weight: bold;
      }

      .password-logo img {
        max-width: {{ settings.logo_width }}px;
        height: auto;
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <div class="password-container">
      <header class="password-header">
        <h1 class="password-logo">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: settings.logo_width | image_tag: alt: shop.name, loading: 'eager' }}
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </h1>
      </header>

      <main id="MainContent" class="password-main">
        {{ content_for_layout }}
      </main>

      <footer class="password-footer">
        {% render 'social-icons' %}
      </footer>
    </div>
  </body>
</html>
