<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>{{ shop.name }}</title>

    {{ 'custom-properties.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="{% if settings.enable_animations %}animations-enabled{% else %}animations-disabled{% endif %} flex items-center justify-center min-h-screen bg-surface">
    <main id="MainContent" role="main" class="aether-container text-center py-12">
      {{ content_for_layout }}
    </main>
  </body>
</html>
