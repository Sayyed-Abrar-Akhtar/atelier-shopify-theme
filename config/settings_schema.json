[
  {
    "name": "theme_info",
    "theme_name": "Aether",
    "theme_author": "Aether Digital",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://example.com/aether/docs",
    "theme_support_url": "https://example.com/aether/support"
  },
  {
    "name": "Global Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable global site animations",
        "info": "Central switch to enable or disable all CSS keyframes, transitions, scroll reveals, and loading spinners globally across the theme.",
        "default": true
      }
    ]
  },
  {
    "name": "Header & Navigation",
    "settings": [
      {
        "type": "select",
        "id": "header_layout_style",
        "label": "Header layout style",
        "info": "Instantly switch between classic dropdowns, rich mega menus, or app-style hamburger-only navigation across all screen sizes.",
        "options": [
          {
            "value": "classic_dropdown",
            "label": "Classic Dropdown"
          },
          {
            "value": "mega_menu",
            "label": "Mega Menu"
          },
          {
            "value": "hamburger_only",
            "label": "Hamburger Only"
          }
        ],
        "default": "mega_menu"
      },
      {
        "type": "checkbox",
        "id": "enable_mega_toggle_switch",
        "label": "Enable mega menu fallback switch",
        "info": "When checked with Mega Menu selected, easily toggle mega menu off globally (falling back to classic dropdown) without changing the main layout setting.",
        "default": true
      },
      {
        "type": "link_list",
        "id": "main_linklist",
        "label": "Main menu",
        "default": "main-menu"
      },
      {
        "type": "checkbox",
        "id": "sticky_header",
        "label": "Enable sticky header",
        "default": true
      }
    ]
  },
  {
    "name": "Localization & Internationalization",
    "settings": [
      {
        "type": "header",
        "content": "Cyprus, EU & Russian Markets Support"
      },
      {
        "type": "paragraph",
        "content": "Note: Greek and English are the primary languages for Cyprus markets. Fully localized for EU and Russian cross-border commerce."
      },
      {
        "type": "select",
        "id": "default_language",
        "label": "Default language",
        "options": [
          { "value": "en", "label": "English" },
          { "value": "el", "label": "Greek (Cyprus)" },
          { "value": "de", "label": "German" },
          { "value": "fr", "label": "French" },
          { "value": "it", "label": "Italian" },
          { "value": "es", "label": "Spanish" },
          { "value": "nl", "label": "Dutch" },
          { "value": "ru", "label": "Russian" },
          { "value": "eu_other", "label": "Other EU languages" }
        ],
        "default": "en"
      },
      {
        "type": "select",
        "id": "default_currency",
        "label": "Default currency",
        "options": [
          { "value": "EUR", "label": "EUR (€)" },
          { "value": "USD", "label": "USD ($)" },
          { "value": "GBP", "label": "GBP (£)" },
          { "value": "RUB", "label": "RUB (₽)" }
        ],
        "default": "EUR"
      },
      {
        "type": "header",
        "content": "Regional Formatting"
      },
      {
        "type": "select",
        "id": "date_format",
        "label": "Date format",
        "info": "EU/Cyprus/Russia standard is DD/MM/YYYY. US standard is MM/DD/YYYY.",
        "options": [
          { "value": "dd_mm_yyyy", "label": "DD/MM/YYYY (EU / Cyprus / Russia)" },
          { "value": "mm_dd_yyyy", "label": "MM/DD/YYYY (US)" }
        ],
        "default": "dd_mm_yyyy"
      },
      {
        "type": "select",
        "id": "number_format_decimal",
        "label": "Decimal separator",
        "info": "EU and Russia standard uses comma (,) for decimals. US uses dot (.).",
        "options": [
          { "value": "comma", "label": "Comma (1.234,56 €)" },
          { "value": "dot", "label": "Dot ($1,234.56)" }
        ],
        "default": "comma"
      },
      {
        "type": "select",
        "id": "selector_placement",
        "label": "Language & Currency switcher placement",
        "options": [
          { "value": "header", "label": "Header only" },
          { "value": "footer", "label": "Footer only" },
          { "value": "both", "label": "Both Header and Footer" }
        ],
        "default": "both"
      },
      {
        "type": "checkbox",
        "id": "enable_rtl",
        "label": "Enable Right-to-Left (RTL) layout support",
        "default": false
      },
      {
        "type": "header",
        "content": "EU GDPR Compliance"
      },
      {
        "type": "checkbox",
        "id": "enable_cookie_consent",
        "label": "Enable GDPR cookie consent banner",
        "info": "Enabled by default for Cyprus and EU compliance.",
        "default": true
      },
      {
        "type": "text",
        "id": "cookie_consent_text",
        "label": "Cookie banner text",
        "default": "We use cookies to improve your browsing experience and analyze site traffic in compliance with EU regulations."
      }
    ]
  },
  {
    "name": "Styling & Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color",
        "default": "#111827"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent color",
        "default": "#2563eb"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / Card background",
        "default": "#f9fafb"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text color",
        "default": "#111827"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale badge color",
        "default": "#dc2626"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "sans-serif"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "sans-serif"
      },
      {
        "type": "range",
        "id": "font_body_size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Base body font size",
        "default": 16
      }
    ]
  },
  {
    "name": "Layout & Spacing",
    "settings": [
      {
        "type": "range",
        "id": "container_max_width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Max container width",
        "default": 1320
      },
      {
        "type": "select",
        "id": "border_radius_style",
        "label": "Global corner rounding",
        "options": [
          { "value": "0px", "label": "Sharp (0px)" },
          { "value": "4px", "label": "Subtle (4px)" },
          { "value": "8px", "label": "Rounded (8px)" },
          { "value": "16px", "label": "Pill / Soft (16px)" }
        ],
        "default": "8px"
      }
    ]
  },
  {
    "name": "Cart & Drawer",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Slide-out Drawer" },
          { "value": "page", "label": "Cart Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "enable_quick_view",
        "label": "Enable Quick View popup on product cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_atc",
        "label": "Enable Sticky Add To Cart bar on product page",
        "default": true
      }
    ]
  }
]
