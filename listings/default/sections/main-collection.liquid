{% comment %}
  Main Collection Section Component
{% endcomment %}

<section class="py-12 bg-background">
  <div class="aether-container">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h1 class="text-4xl font-extrabold text-primary mb-3">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <p class="text-text-muted text-sm leading-relaxed">{{ collection.description }}</p>
      {% endif %}
    </div>

    {% paginate collection.products by 12 %}
      {% if collection.products_count > 0 %}
        <div class="aether-grid grid-cols-1 mobile-grid-2 tablet-grid-3 grid-cols-4 gap-6">
          {% for product in collection.products %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="flex justify-center gap-2 mt-12">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% else %}
        <p class="text-center text-text-muted py-12">No products found in this collection.</p>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "class": "aether-main-collection",
  "settings": []
}
{% endschema %}
