{% comment %}
  Main Cart Page Section
{% endcomment %}

<section class="py-12 bg-background">
  <div class="aether-container max-w-4xl mx-auto">
    <h1 class="text-3xl font-extrabold text-primary mb-8 text-center">{{ 'cart.title' | t }}</h1>

    {% if cart.item_count > 0 %}
      <form action="/cart" method="post" class="space-y-6">
        <div class="divide-y divide-border border-y border-border">
          {% for item in cart.items %}
            <div class="py-6 flex items-center gap-6">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title }}" class="w-24 h-24 object-cover rounded-md">
              {% endif %}
              <div class="flex-grow">
                <a href="{{ item.url }}" class="font-bold text-lg text-primary hover:text-accent block">{{ item.product.title }}</a>
                <span class="text-sm text-text-muted">{{ item.variant.title }}</span>
                <p class="font-bold text-primary text-base mt-1">{{ item.final_line_price | money }}</p>
              </div>
              <div class="flex items-center gap-4">
                <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="w-16 bg-surface border border-border rounded p-2 text-center text-sm">
                <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="text-xs text-sale font-medium hover:underline">{{ 'cart.remove' | t }}</a>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="flex flex-col items-end gap-4 pt-6">
          <div class="text-2xl font-bold text-primary flex items-center gap-4">
            <span>{{ 'cart.subtotal' | t }}:</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <div class="flex gap-4">
            <button type="submit" name="update" class="btn btn-secondary text-sm px-6 py-3">{{ 'cart.view_cart' | t }}</button>
            <button type="submit" name="checkout" class="btn btn-primary text-sm px-8 py-3 hover-lift">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {% else %}
      <div class="text-center py-16">
        <p class="text-text-muted text-lg mb-6">{{ 'cart.empty' | t }}</p>
        <a href="/collections/all" class="btn btn-primary px-8 py-3 text-sm">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "class": "aether-main-cart",
  "settings": []
}
{% endschema %}
