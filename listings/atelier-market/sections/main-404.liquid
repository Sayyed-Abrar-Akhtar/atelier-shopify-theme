{% comment %}
  Main 404 Section
{% endcomment %}

<section class="py-24 bg-surface text-center">
  <div class="aether-container max-w-md mx-auto">
    <h1 class="text-7xl font-black text-primary mb-4">404</h1>
    <h2 class="text-2xl font-bold mb-2">{{ 'general.page_not_found' | t }}</h2>
    <p class="text-text-muted text-sm mb-8">{{ 'general.404_subtext' | t }}</p>
    <a href="/" class="btn btn-primary text-sm px-8 py-3 hover-lift">{{ 'general.back_to_home' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "class": "aether-main-404",
  "settings": []
}
{% endschema %}
